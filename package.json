{
  "name": "@stardust-cms/dashboard",
  "version": "0.1.9",
  "description": "Extensible host dashboard boilerplate for in-iframe visual editors built on @stardust-cms/iframe-adapter.",
  "type": "module",
  "license": "MIT",
  "author": "Daniel Cassil <me@danielcassil.com>",
  "homepage": "https://github.com/dcassil/stardust-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcassil/stardust-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/dcassil/stardust-dashboard/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "import": "./dist/tokens/tokens.css"
    },
    "./theme.css": {
      "import": "./dist/tokens/theme.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@stardust-cms/iframe-adapter": "^0.1.6",
    "frame-link": "^4.0.0",
    "frame-link-react": "^4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@stardust-cms/iframe-adapter": "^0.1.6",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "frame-link": "^4.0.0",
    "frame-link-react": "^4.0.0",
    "husky": "^9.1.7",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ]
  }
}
